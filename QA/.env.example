# ---------------------------------------------------------------------------
# Asimov HR QA (S-105) - example environment file.
#   cp .env.example .env
# NEVER commit a real .env. NEVER put secrets in this file.
# ---------------------------------------------------------------------------

# --- Target application (the only two values that change between
#     local / CI / later staging AS-122) -------------------------------------

# Frontend under test. Local dev default is the Vite dev server.
FRONTEND_URL=http://127.0.0.1:5173

# Backend API under test. The Fastify app listens on PORT (default 3000).
API_URL=http://127.0.0.1:3000

# --- Seed data -------------------------------------------------------------
# LOCAL / TEST PostgreSQL ONLY. The seed script refuses any other host.
# Ask a developer for a throwaway local database URL; never use a production one.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/asimov_test

# Where the backend workspace lives, so the seed reuses the app's own
# prisma/schema.prisma and Prisma Client instead of a copy.
# Paths are resolved from QA/, so they must climb one level to repo/ and one
# more to the Asimov_testing/ directory that holds app/.
API_WORKSPACE_DIR=../../app/backend/apps/api

# Optional: point straight at a schema file instead of a workspace directory.
# PRISMA_SCHEMA_PATH=../../app/backend/apps/api/prisma/schema.prisma

# --- Test runner behaviour -------------------------------------------------
# Set to true to watch the browser locally. CI is always headless.
QA_HEADED=false

# --- Authentication (BLOCKED: app has no login yet) ------------------------
# Fill these in from GitHub secrets once the developer ships sign-in.
# Nothing in the suite currently needs them; no values are committed here.
TEST_USERNAME=
TEST_PASSWORD=
