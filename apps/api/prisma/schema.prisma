generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["platform", "talently", "core", "onboard", "time"]
}

// ---------- platform ----------
model Tenant {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  auditEntries AuditEntry[]
  templates QuestionnaireTemplate[]
  jobs      Job[]
  applications Application[]
  settings TenantSetting[]
  scores   Score[]
  approvalRequests ApprovalRequest[]
  approvalSteps    ApprovalStep[]
  
  @@schema("platform")
}

// ---------- placeholders (delete once real models exist in each schema) ----------
model TalentlyPlaceholder {
  id String @id @default(uuid())

  @@schema("talently")
}

model CorePlaceholder {
  id String @id @default(uuid())

  @@schema("core")
}

model OnboardPlaceholder {
  id String @id @default(uuid())

  @@schema("onboard")
}

model TimePlaceholder {
  id String @id @default(uuid())

  @@schema("time")
}

enum Role {
  OWNER
  ADMIN
  MEMBER

  @@schema("platform")
}

model User {
  id          String       @id          // Supabase auth user id (token la varra "sub")
  email       String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  auditEntries AuditEntry[]

  @@schema("platform")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role
  createdAt DateTime @default(now())
  managerId String? // user id of this member's manager (used by the MANAGER approver rule)

  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])   // oru user, oru tenant la oru membership dhaan
  @@schema("platform")
}

model AuditEntry {
  id        String   @id @default(uuid())
  tenantId  String
  actorId   String
  action    String   // e.g. "member.role_changed"
  entity    String   // e.g. "Membership"
  entityId  String
  before    Json?    // null on create
  after     Json?    // null on delete
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@schema("platform")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  NUMBER_BANDS
  RATING
  SHORT_TEXT
  FILE

  @@schema("talently")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@schema("talently")
}

// One row per VERSION of a template. All versions of the same template share a groupId.
model QuestionnaireTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  groupId   String
  name      String
  version   Int      @default(1)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  questions Question[]
  jobs      Job[]

  @@unique([groupId, version])
  @@index([tenantId])
  @@schema("talently")
}

model Question {
  id         String       @id @default(uuid())
  templateId String
  position   Int
  type       QuestionType
  text       String
  weight     Int          @default(0)
  required   Boolean      @default(true)
  mustHave   Boolean      @default(false)
  answers Answer[]

  template QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options  Option[]

  @@index([templateId])
  @@schema("talently")
}

model Option {
  id           String @id @default(uuid())
  questionId   String
  position     Int
  label        String
  scorePercent Int
  minValue     Float?
  maxValue     Float?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@schema("talently")
}

model Job {
  id              String    @id @default(uuid())
  tenantId        String
  title           String
  location        String
  status          JobStatus @default(DRAFT)
  templateId      String
  templateVersion Int?      // set when the job is published; null while it is a draft
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  applications Application[]
  scoringMethod ScoringMethod @default(form)

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  template QuestionnaireTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId, status])
  @@schema("talently")
}

enum ApplicationStatus {
  RECEIVED
  SCORED

  @@schema("talently")
}

model Application {
  id            String            @id @default(uuid())
  tenantId      String
  jobId         String
  candidateName String
  email         String            // always stored lowercase
  phone         String
  resumeKey     String?           // copy of the FILE answer, for quick access
  consentAt     DateTime          // when the candidate agreed (server time, UTC)
  status        ApplicationStatus @default(RECEIVED)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  job     Job      @relation(fields: [jobId], references: [id])
  answers Answer[]
  scores Score[]

  @@unique([jobId, email]) // the database itself prevents duplicates
  @@index([tenantId, status])
  @@schema("talently")
}

model Answer {
  id            String @id @default(uuid())
  applicationId String
  questionId    String
  value         Json

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id])

  @@unique([applicationId, questionId])
  @@schema("talently")
}

enum ScoringMethod {
  form
  ai
  both

  @@schema("talently")
}

// Per-tenant switches. A missing row means "off".
model TenantSetting {
  id        String   @id @default(uuid())
  tenantId  String
  key       String   // e.g. "scoring.aiEnabled"
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@schema("platform")
}

model Score {
  id              String   @id @default(uuid())
  tenantId        String
  applicationId   String
  scorer          String   // "form" or "ai"
  templateVersion Int
  total           Float
  breakdown       Json
  mustHavesFailed Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, scorer]) // one score per scorer; re-scoring replaces it
  @@index([tenantId])
  @@schema("talently")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN

  @@schema("platform")
}

enum ApprovalStepStatus {
  WAITING   // not its turn yet
  PENDING   // it is this step's turn
  APPROVED
  REJECTED
  CANCELLED // an earlier step rejected, or the request was withdrawn

  @@schema("platform")
}

enum ApproverRule {
  MANAGER
  ROLE
  PERSON

  @@schema("platform")
}

model ApprovalRequest {
  id               String         @id @default(uuid())
  tenantId         String
  module           String         // the module that asked, e.g. "time"
  type             String         // e.g. "leave", "missed_punch", "offer"
  requesterId      String         // plain id, checked in code
  subjectEntity    String         // what the request is about, e.g. "LeaveRequest"
  subjectId        String
  summary          String
  status           ApprovalStatus @default(PENDING)
  decidedAt        DateTime?
  eventPublishedAt DateTime?      // set once approval.decided has been sent
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  steps  ApprovalStep[]

  @@index([tenantId, status])
  @@index([tenantId, requesterId])
  @@index([tenantId, module, subjectEntity, subjectId])
  @@schema("platform")
}

model ApprovalStep {
  id             String             @id @default(uuid())
  tenantId       String
  requestId      String
  position       Int                // 0 = first step
  rule           ApproverRule
  approverRole   Role?              // who may decide when no single person is assigned
  approverUserId String?            // the named person for the PERSON rule
  assignedUserId String?            // the one person who must decide now, once resolved
  status         ApprovalStepStatus @default(WAITING)
  decidedById    String?
  reason         String?
  decidedAt      DateTime?
  activatedAt    DateTime?          // when it became this step's turn (starts the fallback timer)
  escalatedAt    DateTime?          // set when moved to the fallback approver
  escalationNote String?
  createdAt      DateTime           @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, position])
  @@index([status, activatedAt])
  @@index([tenantId, assignedUserId, status])
  @@schema("platform")
}