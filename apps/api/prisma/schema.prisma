generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["platform", "talently", "core", "onboard", "time"]
}

// ---------- platform ----------
model Tenant {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  auditEntries AuditEntry[]
  templates QuestionnaireTemplate[]
  jobs      Job[]
  
  @@schema("platform")
}

// ---------- placeholders (delete once real models exist in each schema) ----------
model TalentlyPlaceholder {
  id String @id @default(uuid())

  @@schema("talently")
}

model CorePlaceholder {
  id String @id @default(uuid())

  @@schema("core")
}

model OnboardPlaceholder {
  id String @id @default(uuid())

  @@schema("onboard")
}

model TimePlaceholder {
  id String @id @default(uuid())

  @@schema("time")
}

enum Role {
  OWNER
  ADMIN
  MEMBER

  @@schema("platform")
}

model User {
  id          String       @id          // Supabase auth user id (token la varra "sub")
  email       String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  auditEntries AuditEntry[]

  @@schema("platform")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])   // oru user, oru tenant la oru membership dhaan
  @@schema("platform")
}

model AuditEntry {
  id        String   @id @default(uuid())
  tenantId  String
  actorId   String
  action    String   // e.g. "member.role_changed"
  entity    String   // e.g. "Membership"
  entityId  String
  before    Json?    // null on create
  after     Json?    // null on delete
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@schema("platform")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  NUMBER_BANDS
  RATING
  SHORT_TEXT
  FILE

  @@schema("talently")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@schema("talently")
}

// One row per VERSION of a template. All versions of the same template share a groupId.
model QuestionnaireTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  groupId   String
  name      String
  version   Int      @default(1)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  questions Question[]
  jobs      Job[]

  @@unique([groupId, version])
  @@index([tenantId])
  @@schema("talently")
}

model Question {
  id         String       @id @default(uuid())
  templateId String
  position   Int
  type       QuestionType
  text       String
  weight     Int          @default(0)
  required   Boolean      @default(true)
  mustHave   Boolean      @default(false)

  template QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options  Option[]

  @@index([templateId])
  @@schema("talently")
}

model Option {
  id           String @id @default(uuid())
  questionId   String
  position     Int
  label        String
  scorePercent Int
  minValue     Float?
  maxValue     Float?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@schema("talently")
}

model Job {
  id              String    @id @default(uuid())
  tenantId        String
  title           String
  location        String
  status          JobStatus @default(DRAFT)
  templateId      String
  templateVersion Int?      // set when the job is published; null while it is a draft
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  template QuestionnaireTemplate @relation(fields: [templateId], references: [id])

  @@index([tenantId, status])
  @@schema("talently")
}