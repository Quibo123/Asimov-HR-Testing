# --- Database (Neon). Pooled address for the app, direct address for migrations and the job queue ---
DATABASE_URL=
DIRECT_URL=
PORT=

# --- Supabase (sign-in) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# --- Cloudflare R2 (resume files) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Behind a proxy (Render): number of proxy hops, usually 1 ---
TRUST_PROXY=


# --- Browser access: comma-separated frontend addresses, no trailing slash ---
CORS_ORIGINS=

# --- Local development only: run the background workers inside "npm run dev" ---
RUN_WORKERS=
# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
APP_BASE_URL=

